  endsAt      DateTime
  note        String?
  visibility  Visibility       @default(WORKSPACE)
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startsAt, endsAt])
  @@index([userId, startsAt])
}

model ShiftType {
  id                 String   @id @default(cuid())
  workspaceId        String
  name               String
  teamId             String?
  /// Brand token name, never a hex value.
  color              String?
  defaultCapacity    Int      @default(1)
  requiresCertTypeId String?
  requiresKeyholder  Boolean  @default(false)
  createdAt          DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shifts    Shift[]

  @@unique([workspaceId, name])
}

model Shift {
  id          String   @id @default(cuid())
  workspaceId String
  shiftTypeId String
  startsAt    DateTime
  endsAt      DateTime
  capacity    Int
  location    String?
  /// Groups recurring instances; the series root carries `rrule`.
  seriesId    String?
  rrule       String?
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  shiftType   ShiftType         @relation(fields: [shiftTypeId], references: [id], onDelete: Cascade)
  assignments ShiftAssignment[]

  @@unique([seriesId, startsAt])
  @@index([workspaceId, startsAt])
}

model ShiftAssignment {
  id          String                @id @default(cuid())
  shiftId     String
  userId      String
  status      ShiftAssignmentStatus @default(CONFIRMED)
  checkedInAt DateTime?
  /// Hours worked in hundredths (150 = 1.5 h).
  hoursCenti  Int?
  createdAt   DateTime              @default(now())

  shift        Shift              @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  swapRequests ShiftSwapRequest[]

  @@unique([shiftId, userId])
  @@index([userId, status])
}

model ShiftSwapRequest {
  id           String          @id @default(cuid())
  assignmentId String
  fromUserId   String
  toUserId     String?
  status       ShiftSwapStatus @default(OPEN)
  createdAt    DateTime        @default(now())
  decidedAt    DateTime?

  assignment ShiftAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, status])
}

/// Training sign-off type (laser cutter, CNC…); gates rota shifts.
model CertType {
  id            String   @id @default(cuid())
  workspaceId   String
  name          String
  description   String?
  validityDays  Int?
  trainerIds    String[] @default([])
  trainerTeamId String?
  createdAt     DateTime @default(now())

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  certifications Certification[]

  @@unique([workspaceId, name])
}

model Certification {
  id             String    @id @default(cuid())
  certTypeId     String
  userId         String
  grantedById    String?
  grantedAt      DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  evidenceFileId String?

  certType     CertType    @relation(fields: [certTypeId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidenceFile FileObject? @relation(fields: [evidenceFileId], references: [id], onDelete: SetNull)

  @@unique([certTypeId, userId, grantedAt])
  @@index([userId])
}

