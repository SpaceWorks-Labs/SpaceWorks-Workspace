// ─────────────────────── Foundations ───────────────────────

model Team {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  /// Brand token name (e.g. "teal", "citron"), never a hex value.
  color       String?
  description String?
  visibility  TeamVisibility @default(PUBLIC)
  archivedAt  DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  channels  Channel[]
  projects  Project[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, archivedAt])
}

model TeamMember {
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

/// Approval chain per subject type. `steps` =
/// [{ approverType: "ROLE"|"TEAM_LEAD"|"USER"|"TEAM", ref, minApprovals, minAmountMinor? }].
model ApprovalPolicy {
  id          String              @id @default(cuid())
  workspaceId String
  subjectType ApprovalSubjectType
  name        String
  steps       Json
  isDefault   Boolean             @default(false)
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requests  ApprovalRequest[]

  @@index([workspaceId, subjectType])
}

model ApprovalRequest {
  id             String              @id @default(cuid())
  workspaceId    String
  policyId       String?
  subjectType    ApprovalSubjectType
  subjectId      String
  /// Snapshot for the approvals inbox (subject title at request time).
  title          String
  requesterId    String
  status         ApprovalStatus      @default(PENDING)
  currentStep    Int                 @default(0)
  /// Policy steps frozen when the request was made.
  steps          Json
  amountMinor    Int?
  currency       String?
  lastRemindedAt DateTime?
  createdAt      DateTime            @default(now())
  decidedAt      DateTime?

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policy    ApprovalPolicy?    @relation(fields: [policyId], references: [id], onDelete: SetNull)
  decisions ApprovalDecision[]

  @@unique([workspaceId, subjectType, subjectId])
  @@index([workspaceId, status, createdAt])
  @@index([requesterId])
}

model ApprovalDecision {
  id         String         @id @default(cuid())
  requestId  String
  step       Int
  approverId String
  /// APPROVED | REJECTED | CHANGES_REQUESTED
  decision   ApprovalStatus
  comment    String?
  createdAt  DateTime       @default(now())

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, step, approverId])
}

/// Generic polymorphic link (contact ↔ task, organisation ↔ invoice, service ↔ doc…).
model RecordLink {
  id          String   @id @default(cuid())
  workspaceId String
  fromType    String
  fromId      String
  toType      String
  toId        String
  label       String?
  createdById String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, fromType, fromId, toType, toId])
  @@index([workspaceId, toType, toId])
}

/// Cross-entity search index (global search + command palette). Filled by the
/// owning area; `searchVector` is generated in SQL (title A, body B) and
/// `title` has a trigram index for fuzzy prefix matches. Never index secrets.
model SearchDocument {
  id           String                   @id @default(cuid())
  workspaceId  String
  entityType   String
  entityId     String
  title        String
  body         String                   @default("")
  url          String
  visibility   Visibility               @default(WORKSPACE)
  teamId       String?
  projectId    String?
  channelId    String?
  ownerId      String?
  updatedAt    DateTime                 @updatedAt
  /// Generated column (see migration); query with $queryRaw only.
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId])
  @@index([workspaceId, entityType])
  @@index([searchVector], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "SearchDocument_title_trgm_idx")
}

model ActivityEvent {
  id          String     @id @default(cuid())
  workspaceId String
  actorId     String?
  verb        String
  entityType  String
  entityId    String
  summary     String
  visibility  Visibility @default(WORKSPACE)
  teamId      String?
  projectId   String?
  data        Json?
  createdAt   DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
}

model SavedView {
  id          String     @id @default(cuid())
  workspaceId String
  /// task | contact | asset | service | subscription | expense | monitor …
  entityType  String
  name        String
  /// { filters, sort, groupBy, columns }
  query       Json
  /// LIST | BOARD | TABLE | CALENDAR
  layout      String     @default("LIST")
  ownerId     String
  shared      Visibility @default(PRIVATE)
  teamId      String?
  pinned      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType])
  @@index([ownerId])
}

model Bookmark {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  entityType  String
  entityId    String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, entityType, entityId])
}

/// Workspace links library ("Bank portal", "Member form"…).
model LinkItem {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  url         String
  description String?
  tags        String[]  @default([])
  teamId      String?
  pinned      Boolean   @default(false)
  /// Last HEAD status code from the weekly link check.
  lastStatus  Int?
  checkedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, pinned])
}

// ─────────────────────── People ───────────────────────

/// Workspace-specific profile extension (User keeps name, bio, pronouns,
/// timezone; Membership keeps role and title). Emergency contact is encrypted
/// (purpose "member-emergency") and visible only to OWNER/ADMIN and the member.
model MemberProfile {
  id                  String         @id @default(cuid())
  workspaceId         String
  userId              String
  membershipType      MembershipType @default(MEMBER)
  location            String?
  interests           String[]       @default([])
  /// { telegram, github, linkedin, website }
  handles             Json           @default("{}")
  /// e.g. { "tue": "evening", "thu": "evening" }
  weeklyAvailability  Json?
  isKeyholder         Boolean        @default(false)
  /// Encrypted { name, relation, phone, notes }.
  emergencyContactEnc String?
  emergencyUpdatedAt  DateTime?
  engagementType      String         @default("VOLUNTEER")
  engagementStart     DateTime?      @db.Date
  engagementEnd       DateTime?      @db.Date
  leavingAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            MemberSkill[]
  departmentId      String?
  managerId         String?
  contactPhone      String?
  contactHandle     String?
  contactVisibility Visibility    @default(PRIVATE)
  department        Department?   @relation(fields: [workspaceId, departmentId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, userId])
  @@index([workspaceId, membershipType])
  @@index([workspaceId, departmentId])
  @@index([workspaceId, managerId])
}

model MemberSkill {
  id          String @id @default(cuid())
  profileId   String
  /// Denormalised for "who can solder SMD?" queries.
  workspaceId String
  /// Normalised lowercase tag.
  skill       String
  /// 1 (learning) … 3 (can teach).
  level       Int    @default(1)

  profile MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, skill])
  @@index([workspaceId, skill])
}

/// `items` = [{ title, descriptionMd, assigneeRule: SUBJECT|ROLE|TEAM_LEAD|USER, assigneeRef, dueOffsetDays, required, link }].
model ChecklistTemplate {
  id           String        @id @default(cuid())
  workspaceId  String
  kind         ChecklistKind
  name         String
  teamId       String?
  items        Json
  /// Auto-start trigger: a MembershipType or a team id.
  autoStartFor String?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs      ChecklistRun[]

  @@index([workspaceId, kind])
}

model ChecklistRun {
  id            String             @id @default(cuid())
  workspaceId   String
  templateId    String?
  kind          ChecklistKind
  title         String
  subjectUserId String?
  status        ChecklistRunStatus @default(OPEN)
  dueAt         DateTime?
  createdById   String?
  createdAt     DateTime           @default(now())
  completedAt   DateTime?

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  ChecklistTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  items     ChecklistRunItem[]

  @@index([workspaceId, status])
  @@index([subjectUserId])
}

model ChecklistRunItem {
  id            String    @id @default(cuid())
  runId         String
  title         String
  descriptionMd String?
  assigneeId    String?
  dueAt         DateTime?
  required      Boolean   @default(true)
  /// Generated offboarding items point at the record: vault_item | service | asset | access_credential | subscription | identity_link | team | task.
  sourceType    String?
  sourceId      String?
  doneAt        DateTime?
  doneById      String?
  note          String?
  sortOrder     Int       @default(0)

  run ChecklistRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, sortOrder])
  @@index([assigneeId, doneAt])
}

model Availability {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
