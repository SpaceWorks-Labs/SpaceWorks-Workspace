  children       MoneyControlRecord[]     @relation("MoneyControlParent")
  attachments    MoneyControlAttachment[]
  movements      MoneyControlMovement[]
  events         MoneyControlEvent[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, kind, recordKey])
  @@unique([workspaceId, kind, number])
  @@index([workspaceId, kind, occurredOn])
  @@index([workspaceId, ownerId, status, dueOn])
  @@index([workspaceId, assetId, kind])
  @@index([workspaceId, fundId, kind])
}

model MoneyControlAttachment {
  id          String             @id @default(cuid())
  workspaceId String
  recordId    String
  fileId      String             @unique
  createdAt   DateTime           @default(now())
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record      MoneyControlRecord @relation(fields: [workspaceId, recordId], references: [workspaceId, id], onDelete: Cascade)
  file        FileObject         @relation(fields: [workspaceId, fileId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, recordId])
}

// These movements affect cash only, never income or expense reports.
model MoneyControlMovement {
  id           String             @id @default(cuid())
  workspaceId  String
  recordId     String
  accountId    String
  amountMinor  Int
  currency     String
  occurredOn   DateTime           @db.Date
  reference    String
  operationKey String
  reconciledAt DateTime?
  createdAt    DateTime           @default(now())
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  account      FinanceAccount     @relation("MoneyControlMovementAccount", fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: NoAction, onUpdate: Cascade, map: "MoneyControlMovement_account_tenant_fkey")
  record       MoneyControlRecord @relation(fields: [workspaceId, recordId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, operationKey, accountId])
  @@index([workspaceId, accountId, occurredOn])
  @@index([workspaceId, recordId])
}

// Append-only action and filing acknowledgement history; no uploaded file bodies.
model MoneyControlEvent {
  id          String             @id @default(cuid())
  workspaceId String
  recordId    String
  actorId     String
  action      String
  reference   String             @default("")
  notes       String             @default("")
  createdAt   DateTime           @default(now())
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record      MoneyControlRecord @relation(fields: [workspaceId, recordId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, recordId, createdAt])
}

// Governance and safety extras. Confidential case authority is explicit, never inherited from role.
model SafeguardingHandler {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String
  committeeId   String
  appointedById String
  endsOn        DateTime  @db.Date
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, committeeId, revokedAt])
}

model SafeguardingCase {
  id          String                   @id @default(cuid())
  workspaceId String
  number      Int
  kind        String
  status      String                   @default("OPEN")
  handlerIds  String[]                 @default([])
  receivedOn  DateTime                 @db.Date
  dueOn       DateTime                 @db.Date
  detailsEnc  String
  createdById String
  createdAt   DateTime                 @default(now())
  closedAt    DateTime?
  workspace   Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events      SafeguardingEvent[]
  attachments SafeguardingAttachment[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, number])
  @@index([workspaceId, status, dueOn])
}

model SafeguardingEvent {
  id          String           @id @default(cuid())
  workspaceId String
  caseId      String
  kind        String
  bodyEnc     String
  ownerId     String?
  dueOn       DateTime?        @db.Date
  completedAt DateTime?
  actorId     String
  createdAt   DateTime         @default(now())
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case        SafeguardingCase @relation(fields: [workspaceId, caseId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, caseId, createdAt])
}

model SafeguardingAttachment {
  id          String           @id @default(cuid())
  workspaceId String
  caseId      String
  fileId      String
  createdAt   DateTime         @default(now())
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  case        SafeguardingCase @relation(fields: [workspaceId, caseId], references: [workspaceId, id], onDelete: Cascade)
  file        FileObject       @relation(fields: [workspaceId, fileId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, fileId])
  @@index([workspaceId, caseId])
}

// Shared manual financial documents and people letters. Issued snapshots are immutable.
model BusinessDocument {
  id             String               @id @default(cuid())
  workspaceId    String
  type           String
  status         String               @default("DRAFT")
  title          String
  issuedOn       DateTime             @db.Date
  dueOn          DateTime?            @db.Date
  currency       String               @default("INR")
  financialYear  String?
  number         String?
  registrationId String               @default("")
  ownerId        String
  sourceType     String?
  sourceId       String?
  parentId       String?
  /// Validated draft inputs; frozen with identity/calculations at reservation.
  input          Json
  snapshot       Json?
  totalMinor     Int                  @default(0)
  issuedAt       DateTime?
  issuedById     String?
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent         BusinessDocument?    @relation("DocumentCorrection", fields: [workspaceId, parentId], references: [workspaceId, id], onDelete: NoAction)
  corrections    BusinessDocument[]   @relation("DocumentCorrection")
  files          DocumentFile[]
  allocations    DocumentAllocation[] @relation("AllocationInvoice")
  payments       DocumentAllocation[] @relation("AllocationReceipt")
  deliveries     DocumentDelivery[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, financialYear, number])
  @@index([workspaceId, sourceType, sourceId])
  @@index([workspaceId, status, issuedOn])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, parentId])
}

model DocumentSeries {
  id             String    @id @default(cuid())
  workspaceId    String
  type           String
  registrationId String    @default("")
  financialYear  String
  prefix         String
  padding        Int       @default(5)
  nextNumber     Int       @default(1)
  locked         Boolean   @default(false)
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type, registrationId, financialYear])
  @@index([workspaceId, financialYear])
}

/// Editable item/rate/template records; revisions survive through document snapshots.
model DocumentReference {
  id          String    @id @default(cuid())
  workspaceId String
  kind        String
  name        String
  data        Json
  archivedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, id])
  @@index([workspaceId, kind, archivedAt])
}

model DocumentFile {
  id          String            @id @default(cuid())
  workspaceId String
  documentId  String?
  /// PROFILE, SOURCE, PDF, IRP_QR, IRP_JSON, OFFICIAL_CERTIFICATE, FILING_ACK.
  kind        String
  fileId      String
  createdAt   DateTime          @default(now())
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document    BusinessDocument? @relation(fields: [workspaceId, documentId], references: [workspaceId, id], onDelete: NoAction)
  file        FileObject        @relation(fields: [workspaceId, fileId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, fileId])
  @@index([workspaceId, documentId, kind])
}

/// Signed allocations: invoice settlement, credits, advances and refund reversals.
model DocumentAllocation {
  id          String           @id @default(cuid())
  workspaceId String
  receiptId   String
  invoiceId   String
  cashMinor   Int
  tdsMinor    Int              @default(0)
  key         String
  createdById String
  createdAt   DateTime         @default(now())
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  receipt     BusinessDocument @relation("AllocationReceipt", fields: [workspaceId, receiptId], references: [workspaceId, id], onDelete: NoAction)
  invoice     BusinessDocument @relation("AllocationInvoice", fields: [workspaceId, invoiceId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, key])
  @@index([workspaceId, invoiceId])
  @@index([workspaceId, receiptId])
}

model DocumentDelivery {
  id          String           @id @default(cuid())
  workspaceId String
  documentId  String
  recipient   String
  fileId      String
  checksum    String
  outboxId    String
  createdById String
  createdAt   DateTime         @default(now())
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document    BusinessDocument @relation(fields: [workspaceId, documentId], references: [workspaceId, id], onDelete: NoAction)

  @@index([workspaceId, documentId, createdAt])
}

// Organisation structure and manual people registers. Actor/member ids are resolved in the tenant.
model Department {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  headId      String?
  parentId    String?
  notes       String          @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      Department?     @relation("DepartmentTree", fields: [workspaceId, parentId], references: [workspaceId, id], onDelete: NoAction)
  children    Department[]    @relation("DepartmentTree")
  members     MemberProfile[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, name])
  @@index([workspaceId, parentId])
}

model Responsibility {
  id             String    @id @default(cuid())
  workspaceId    String
  title          String
  status         String    @default("ACTIVE")
  responsibleIds String[]  @default([])
  accountableId  String
  consultedIds   String[]  @default([])
  informedIds    String[]  @default([])
  backupId       String?
  reviewOn       DateTime  @db.Date
  reminderDays   Int       @default(7)
  notes          String    @default("")
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, reviewOn])
  @@index([workspaceId, accountableId])
}

model AttendanceEntry {
  id           String    @id @default(cuid())
  workspaceId  String
  userId       String
  dateOn       DateTime  @db.Date
  status       String
  notes        String    @default("")
  recordedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, dateOn])
  @@index([workspaceId, dateOn])
}

model OrgEscalationPath {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  hoursNote   String    @default("")
  notes       String    @default("")
  steps       Json      @default("[]")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, active])
}

model OrgPeopleAttachment {
  id          String     @id @default(cuid())
  workspaceId String
  kind        String
  recordId    String
  fileId      String
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file        FileObject @relation(fields: [workspaceId, fileId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, fileId])
  @@index([workspaceId, kind, recordId])
}

// Manual marketing and IT administration. Linked source ids are tenant-validated by the service.
model MarketingItRecord {
  id             String                  @id @default(cuid())
  workspaceId    String
  kind           String
  title          String
  status         String
  ownerId        String?
  assetId        String?
  subscriptionId String?
  dateOn         DateTime?               @db.Date
  dueOn          DateTime?               @db.Date
  reminderDays   Int                     @default(1)
  details        Json                    @default("{}")
  notes          String                  @default("")
  completedAt    DateTime?
  completedById  String?
  createdById    String
  archivedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  workspace      Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attachments    MarketingItAttachment[]
  events         MarketingItEvent[]
  reviewItems    MarketingItReviewItem[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, assetId])
  @@unique([workspaceId, subscriptionId])
  @@index([workspaceId, kind, archivedAt, dueOn])
  @@index([workspaceId, ownerId])
}

model MarketingItAttachment {
  id          String            @id @default(cuid())
  workspaceId String
  recordId    String
  fileId      String
  // Existing library files remain in the library; dedicated proofs stay private.
  fromLibrary Boolean           @default(false)
  createdAt   DateTime          @default(now())
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record      MarketingItRecord @relation(fields: [workspaceId, recordId], references: [workspaceId, id], onDelete: Cascade)
  file        FileObject        @relation(fields: [workspaceId, fileId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, recordId, fileId])
  @@index([workspaceId, fileId])
}

model MarketingItEvent {
  id          String            @id @default(cuid())
  workspaceId String
  recordId    String
  actorId     String
  action      String
  note        String            @default("")
  data        Json              @default("{}")
  createdAt   DateTime          @default(now())
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record      MarketingItRecord @relation(fields: [workspaceId, recordId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, recordId, createdAt])
}

model MarketingItReviewItem {
  id           String            @id @default(cuid())
  workspaceId  String
  recordId     String
  userId       String
  sourceType   String
  sourceId     String
  label        String
  path         String
  decision     String            @default("PENDING")
  note         String            @default("")
  reviewedById String?
  reviewedAt   DateTime?
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record       MarketingItRecord @relation(fields: [workspaceId, recordId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, recordId, userId, sourceType, sourceId])
  @@index([workspaceId, recordId])
  @@index([workspaceId, userId])
}

// Application secrets. All tenant references use compound tenant keys.
model SecretProject {
  identities     SecretIdentity[]
  encryptionKeys VaultKey[]
  rotations      SecretKeyRotation[]
  id             String              @id @default(cuid())
  workspaceId    String
  name           String
  slug           String
  createdById    String
  createdAt      DateTime            @default(now())
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environments   SecretEnvironment[]
  grants         SecretGrant[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, slug])
}

model SecretEnvironment {
  id                  String                     @id @default(cuid())
  workspaceId         String
  projectId           String
  name                String
  slug                String
  position            Int                        @default(0)
  production          Boolean                    @default(false)
  protected           Boolean                    @default(false)
  revision            Int                        @default(0)
  workspace           Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project             SecretProject              @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  folders             SecretFolder[]
  secrets             ApplicationSecret[]
  snapshots           SecretSnapshot[]
  changes             SecretChange[]
  identityPermissions SecretIdentityPermission[]
  tokens              SecretServiceToken[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, projectId, slug])
  @@index([workspaceId, projectId, position])
}

model SecretGrant {
  id            String        @id @default(cuid())
  workspaceId   String
  projectId     String
  // Empty means project-level; an environment grant overrides it, including NONE.
  environmentId String        @default("")
  userId        String
  role          String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       SecretProject @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, projectId, environmentId, userId])
  @@index([workspaceId, userId])
}

model SecretFolder {
  id            String            @id @default(cuid())
  workspaceId   String
  environmentId String
  path          String
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environment   SecretEnvironment @relation(fields: [workspaceId, environmentId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, environmentId, path])
}

model ApplicationSecret {
  id              String                     @id @default(cuid())
  workspaceId     String
  environmentId   String
  path            String                     @default("/")
  key             String
  secretEnc       String
  dataKeyEnc      String
  comment         String                     @default("")
  tags            String[]                   @default([])
  ownerId         String
  rotateEveryDays Int?
  rotatedAt       DateTime                   @default(now())
  deletedAt       DateTime?
  updatedAt       DateTime                   @updatedAt
  workspace       Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environment     SecretEnvironment          @relation(fields: [workspaceId, environmentId], references: [workspaceId, id], onDelete: Cascade)
  versions        ApplicationSecretVersion[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, environmentId, path, key])
  @@index([workspaceId, ownerId, rotatedAt])
}

model ApplicationSecretVersion {
  id          String            @id @default(cuid())
  workspaceId String
  secretId    String
  secretEnc   String
  dataKeyEnc  String
  metadata    Json
  deleted     Boolean           @default(false)
  createdById String
  createdAt   DateTime          @default(now())
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  secret      ApplicationSecret @relation(fields: [workspaceId, secretId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, secretId, createdAt])
}

model SecretSnapshot {
  id            String            @id @default(cuid())
  workspaceId   String
  environmentId String
  revision      Int
  label         String
  secretEnc     String
  dataKeyEnc    String
  createdById   String
  createdAt     DateTime          @default(now())
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environment   SecretEnvironment @relation(fields: [workspaceId, environmentId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, environmentId, createdAt])
}

model SecretChange {
  id            String            @id @default(cuid())
  workspaceId   String
  environmentId String
  revision      Int
  secretEnc     String
  dataKeyEnc    String
  // Key names and operation only; never values or comments.
  diff          Json
  status        String            @default("PENDING")
  createdById   String
  createdAt     DateTime          @default(now())
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environment   SecretEnvironment @relation(fields: [workspaceId, environmentId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, environmentId, status])
}

model SecretServiceToken {
  id            String            @id @default(cuid())
  workspaceId   String
  environmentId String
  name          String
  prefix        String            @unique
  secretHash    String
  path          String            @default("/")
  writable      Boolean           @default(false)
  ipAllowlist   String[]          @default([])
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdById   String
  createdAt     DateTime          @default(now())
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  environment   SecretEnvironment @relation(fields: [workspaceId, environmentId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, environmentId, revokedAt])
}

model SecretShare {
  id             String    @id @default(cuid())
  workspaceId    String
  projectId      String
  capabilityHash String    @unique
  // Browser-encrypted AES-GCM ciphertext. Fragment key is never transmitted.
  ciphertext     String
  remainingViews Int       @default(1)
  expiresAt      DateTime
  createdById    String
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId, expiresAt])
}

model SecretAudit {
  secretKey     String?
  id            String    @id @default(cuid())
  workspaceId   String
  projectId     String
  environmentId String?
  actorId       String?
  action        String
  targetId      String?
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId, createdAt])
  @@index([workspaceId, environmentId, action])
}

// Device and CLI sessions are user authentication records, independent of tenants.
model CliDeviceCode {
  id             String    @id @default(cuid())
  deviceHash     String    @unique
  userCodeHash   String    @unique
  deviceName     String
  scope          String    @default("secrets")
  expiresAt      DateTime
  lastPolledAt   DateTime?
  status         String    @default("PENDING")
  userId         String?
  mfaAt          DateTime?
  sessionVersion Int?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

model CliSession {
  id               String    @id @default(cuid())
  userId           String
  name             String
  accessHash       String    @unique
  refreshHash      String    @unique
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  sessionVersion   Int
  mfaAt            DateTime?
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// Universal authentication credentials and access leases are always stored hashed.
model SecretIdentity {
  id             String                     @id @default(cuid())
  workspaceId    String
  projectId      String
  name           String
  clientId       String                     @unique
  createdById    String
  accessTtl      Int                        @default(7200)
  maxTtl         Int                        @default(2592000)
  tokenUses      Int?
  secretUses     Int?
  secretTtl      Int?
  loginIps       String[]                   @default([])
  tokenIps       String[]                   @default([])
  failureLimit   Int                        @default(3)
  lockoutSeconds Int                        @default(300)
  failures       Int                        @default(0)
  lockedUntil    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                   @default(now())
  workspace      Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        SecretProject              @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  credentials    SecretIdentityCredential[]
  tokens         SecretIdentityToken[]
  permissions    SecretIdentityPermission[]

  @@unique([workspaceId, id])
  @@index([workspaceId, projectId])
}

model SecretIdentityPermission {
  id            String            @id @default(cuid())
  workspaceId   String
  identityId    String
  environmentId String
  path          String            @default("/")
  role          String            @default("READ")
  identity      SecretIdentity    @relation(fields: [workspaceId, identityId], references: [workspaceId, id], onDelete: Cascade)
  environment   SecretEnvironment @relation(fields: [workspaceId, environmentId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, identityId, environmentId, path])
}

model SecretIdentityCredential {
  id            String                @id @default(cuid())
  workspaceId   String
  identityId    String
  secretHash    String
  remainingUses Int?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime              @default(now())
  identity      SecretIdentity        @relation(fields: [workspaceId, identityId], references: [workspaceId, id], onDelete: Cascade)
  tokens        SecretIdentityToken[]

  @@unique([workspaceId, id])
  @@index([workspaceId, identityId])
}

model SecretIdentityToken {
  id            String                   @id @default(cuid())
  workspaceId   String
  identityId    String
  credentialId  String
  tokenHash     String                   @unique
  expiresAt     DateTime
  maxExpiresAt  DateTime
  remainingUses Int?
  revokedAt     DateTime?
  createdAt     DateTime                 @default(now())
  identity      SecretIdentity           @relation(fields: [workspaceId, identityId], references: [workspaceId, id], onDelete: Cascade)
  credential    SecretIdentityCredential @relation(fields: [workspaceId, credentialId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, identityId, revokedAt])
}

// Wrapped internal keys. Database rows contain no unwrapped key material.
model VaultKey {
  id          String         @id @default(cuid())
  workspaceId String
  projectId   String?
  scope       String
  version     Int
  wrappedKey  String
  parentId    String?
  rootVersion Int?
  fingerprint String
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  retiredAt   DateTime?
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     SecretProject? @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, scope, version])
  @@index([workspaceId, projectId, active])
}

model SecretKeyRotation {
  id          String        @id @default(cuid())
  workspaceId String
  projectId   String
  kind        String
  status      String        @default("PENDING")
  processed   Int           @default(0)
  total       Int           @default(0)
  cursor      String?
  createdById String
  createdAt   DateTime      @default(now())
  finishedAt  DateTime?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     SecretProject @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, projectId, createdAt])
}

// Manual product and engineering tools. Validated kind-specific facts live in productOps/schema.
enum ProductKind {
  ROADMAP
  RELEASE
  ISSUE
  QA_RUN
  ESTIMATE
  PROTOTYPE
  TEST
  CHANGE
}

model ProductRecord {
  id           String                    @id @default(cuid())
  workspaceId  String
  kind         ProductKind
  title        String
  status       String
  ownerId      String?
  projectId    String?
  releaseId    String?
  parentId     String?
  fundingId    String?
  budgetId     String?
  fundId       String?
  dueOn        DateTime?                 @db.Date
  dateOn       DateTime?                 @db.Date
  reminderDays Int                       @default(7)
  currency     String                    @default("INR")
  notes        String                    @default("")
  details      Json                      @default("{}")
  revision     Int                       @default(1)
  approvalId   String?
  shippedAt    DateTime?
  changelogId  String?
  archivedAt   DateTime?
  createdById  String
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  workspace    Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  release      ProductRecord?            @relation("ProductReleaseItems", fields: [workspaceId, releaseId], references: [workspaceId, id], onDelete: NoAction)
  releaseItems ProductRecord[]           @relation("ProductReleaseItems")
  parent       ProductRecord?            @relation("ProductPrototypeTests", fields: [workspaceId, parentId], references: [workspaceId, id], onDelete: NoAction)
  children     ProductRecord[]           @relation("ProductPrototypeTests")
  estimates    ProductEstimateRevision[]
  attachments  ProductAttachment[]

  @@unique([workspaceId, id])
  @@index([workspaceId, kind, archivedAt, dueOn])
  @@index([workspaceId, projectId])
  @@index([workspaceId, releaseId])
  @@index([workspaceId, parentId])
  @@index([workspaceId, ownerId])
}

// Immutable estimate snapshots, including the exact quote file references used at that revision.
model ProductEstimateRevision {
  id          String        @id @default(cuid())
  workspaceId String
  recordId    String
  version     Int
  snapshot    Json
  createdById String
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record      ProductRecord @relation(fields: [workspaceId, recordId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, recordId, version])
}

model ProductAttachment {
  id          String        @id @default(cuid())
  workspaceId String
  recordId    String
  fileId      String
  generated   Boolean       @default(false)
  version     Int?
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  record      ProductRecord @relation(fields: [workspaceId, recordId], references: [workspaceId, id], onDelete: Cascade)
  file        FileObject    @relation(fields: [workspaceId, fileId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, fileId])
  @@index([workspaceId, recordId])
}

// Manual recurring obligations create ordinary supplier bills, never a second payment store.
model RecurringCostSchedule {
  id                  String             @id @default(cuid())
  workspaceId         String
  requestKey          String
  title               String
  kind                String
  payee               String
  contactId           String?
  organisationId      String?
  amountMinor         Int
  currency            String             @default("INR")
  estimated           Boolean            @default(false)
  frequency           String             @default("MONTHLY")
  dueDay              Int                @default(1)
  startsOn            DateTime           @db.Date
  endsOn              DateTime?          @db.Date
  nextDueOn           DateTime           @db.Date
  leadDays            Int                @default(14)
  reminderDays        Int                @default(7)
  categoryId          String?
  fundId              String?
  costCentreId        String?
  accountId           String?
  ownerId             String?
  gstPercent          Float              @default(0)
  tdsSection          String             @default("")
  tdsPercent          Float              @default(0)
  leaseId             String?
  subscriptionId      String?
  insuranceId         String?
  depositId           String?
  escalationPercent   Float              @default(0)
  renewalOn           DateTime?          @db.Date
  renewalReminderDays Int                @default(30)
  principalMinor      Int                @default(0)
  annualRatePercent   Float              @default(0)
  tenure              Int                @default(0)
  status              String             @default("ACTIVE")
  notes               String             @default("")
  createdById         String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dues                RecurringCostDue[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, requestKey])
  @@unique([workspaceId, leaseId])
  @@unique([workspaceId, insuranceId])
  @@index([workspaceId, status, nextDueOn])
  @@index([workspaceId, fundId, costCentreId])
}

model RecurringCostDue {
  id             String                 @id @default(cuid())
  workspaceId    String
  scheduleId     String?
  sourceKey      String
  kind           String
  dueOn          DateTime               @db.Date
  billId         String
  payRunId       String?
  principalMinor Int                    @default(0)
  interestMinor  Int                    @default(0)
  splitConfirmed Boolean                @default(false)
  workspace      Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  schedule       RecurringCostSchedule? @relation(fields: [workspaceId, scheduleId], references: [workspaceId, id], onDelete: NoAction)
  bill           FinanceBill            @relation(fields: [workspaceId, billId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, sourceKey])
  @@unique([workspaceId, billId])
  @@index([workspaceId, dueOn, kind])
  @@index([workspaceId, scheduleId])
}

// The existing deposit movements hold advance cash; these rows only schedule recovery.
model StaffAdvance {
  id           String                 @id @default(cuid())
  workspaceId  String
  requestKey   String
  userId       String
  profileId    String
  reason       String
  amountMinor  Int
  currency     String
  instalments  Int
  startsOn     DateTime               @db.Date
  accountId    String
  costCentreId String?
  fundId       String?
  approvalId   String?
  depositId    String?
  paidOn       DateTime?              @db.Date
  status       String                 @default("DRAFT")
  createdById  String
  createdAt    DateTime               @default(now())
  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recoveries   StaffAdvanceRecovery[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, requestKey])
  @@index([workspaceId, userId, status])
}

model StaffAdvanceRecovery {
  id             String       @id @default(cuid())
  workspaceId    String
  advanceId      String
  instalment     Int
  dueOn          DateTime     @db.Date
  amountMinor    Int
  recoveredMinor Int          @default(0)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  advance        StaffAdvance @relation(fields: [workspaceId, advanceId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, advanceId, instalment])
  @@index([workspaceId, dueOn])
}

// Simple manual project planning and weekly check-ins.
model ProjectMilestone {
  id          String                 @id @default(cuid())
  workspaceId String
  projectId   String
  name        String
  targetOn    DateTime               @db.Date
  status      String                 @default("PENDING")
  notes       String                 @default("")
  createdById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project                @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)
  tasks       ProjectMilestoneTask[]

  @@unique([workspaceId, projectId, id])
  @@index([workspaceId, projectId, targetOn])
}

model ProjectMilestoneTask {
  workspaceId String
  projectId   String
  milestoneId String
  taskId      String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  milestone   ProjectMilestone @relation(fields: [workspaceId, projectId, milestoneId], references: [workspaceId, projectId, id], onDelete: Cascade)
  task        Task             @relation(fields: [workspaceId, projectId, taskId], references: [workspaceId, projectId, id], onDelete: Cascade)

  @@id([workspaceId, milestoneId, taskId])
  @@index([workspaceId, taskId])
}

/// Per-project task type (Task, Bug, Feature by default; created lazily).
model ProjectTaskType {
  id          String       @id @default(cuid())
  workspaceId String
  projectId   String
  name        String
  tone        LabelTone    @default(NEUTRAL)
  icon        TaskTypeIcon @default(TASK)
  isDefault   Boolean      @default(false)
  position    Int          @default(0)
  createdAt   DateTime     @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, name])
  @@index([workspaceId, projectId, position])
}

model ProjectStatusUpdate {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  status      String
  note        String
  blockers    String[]  @default([])
  nextSteps   String[]  @default([])
  authorId    String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, projectId, createdAt])
}

// Reports read existing records. Only presets and one-off forecast assumptions are new.
model AnalyticsPreset {
  id          String    @id @default(cuid())
  workspaceId String
  ownerId     String
  name        String
  section     String
  query       Json
  shared      Boolean   @default(false)
  pinned      Boolean   @default(false)
  commentary  String    @default("")
  fileIds     String[]  @default([])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, ownerId])
  @@index([workspaceId, shared, pinned])
}

model AnalyticsAdjustment {
  id           String    @id @default(cuid())
  workspaceId  String
  title        String
  dueOn        DateTime  @db.Date
  amountMinor  Int
  currency     String
  fundId       String?
  costCentreId String?
  notes        String    @default("")
  fileIds      String[]  @default([])
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, currency, dueOn])
}
