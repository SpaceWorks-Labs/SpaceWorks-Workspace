// Space Works Workspace data model.
//
// This schema covers every product area (foundation, work, chat, knowledge,
// community, operations and the assistant). `Workspace` is the tenant
// boundary: every tenant row carries `workspaceId` (directly or through its
// parent) and every query must filter by it after a membership check.
//
// Full-text search: `Task`, `Message` and `Doc` have a generated `tsvector`
// column (`searchVector`) with a GIN index, created in SQL by the initial
// migration. Prisma treats the column as `Unsupported`, so it is read only
// through `$queryRaw` (`searchVector @@ websearch_to_tsquery('simple', $1)`).
//
// The platform extension (migration `platform_extension`) appends the
// internal-team, Services monitor and messaging/notification-routing models
// at the end of this file. Columns that point at people or other areas
// (`createdById`, `ownerId`, `teamId`…) are plain ids unless a relation is
// needed for integrity; personal rows cascade with their user and every
// tenant root cascades with its workspace.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries use DATABASE_URL (may be a transaction pooler with
  // ?pgbouncer=true). Migrations use DIRECT_URL; scripts/prisma.mjs defaults
  // it to DATABASE_URL when there is no separate direct connection.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
  ARCHIVED
}

enum ColumnCategory {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Matches the brand status-pill tones (components/ui/display.tsx `ChipTone`).
enum LabelTone {
  NEUTRAL
  SUCCESS
  WARNING
  INFO
  DANGER
  ACCENT
  HIGHLIGHT
}

/// Glyph of a per-project task type (mapped to approved icons in components/tasks/typeIcons.ts).
enum TaskTypeIcon {
  TASK
  BUG
  FEATURE
  DOCS
  CHORE
  MILESTONE
  IDEA
  RISK
}

enum ChannelKind {
  PUBLIC
  PRIVATE
  DIRECT
}

enum NotifyLevel {
  ALL
  MENTIONS
  NONE
}

enum MessageAuthorKind {
  USER
  ASSISTANT
  SYSTEM
}

enum DocVisibility {
  WORKSPACE
  ADMINS
}

enum LedgerKind {
  INCOME
  EXPENSE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum AssistantRole {
  USER
  ASSISTANT
  TOOL
}

enum IntegrationProvider {
  SOCIAL_YOUTUBE
  SOCIAL_META
  SOCIAL_LINKEDIN
  SOCIAL_X
  GOOGLE
  GITHUB
  TELEGRAM
}

enum IntegrationStatus {
  ACTIVE
  ERROR
  REVOKED
}

enum BoardroomStatus {
  DRAFT
  RUNNING
  DONE
  FAILED
}

enum BoardroomTurnRole {
  SEAT
  MODERATOR
}

// ──────────────────────── Auth and instance ────────────────────────

model User {
  cliSessions        CliSession[]
  personalNotes      PersonalNote[]
  personalTodos      PersonalTodo[]
  id                 String         @id @default(cuid())
  name               String?
  email              String         @unique
  emailVerified      DateTime?
  /// Bcrypt hash for email + password sign-in. Null for Google-only users.
  passwordHash       String?
  image              String?
  bio                String?
  pronouns           String?
  skills             String[]       @default([])
  timezone           String?
  /// AES-GCM encrypted TOTP seed (lib/mfa.ts). Never expose or log it.
  mfaSecretEncrypted String?
  mfaEnabledAt       DateTime?
  /// Incremented to invalidate every issued JWT session (password reset, sign out everywhere).
  sessionVersion     Int            @default(0)
  lastSeenAt         DateTime?
  /// Set by a super-admin; disabled users cannot sign in.
  disabledAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  accounts                Account[]
  sessions                Session[]
  mfaRecoveryCodes        MfaRecoveryCode[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  memberships             Membership[]
  invitationsSent         Invitation[]             @relation("InvitationInvitedBy")
  invitationsAccepted     Invitation[]             @relation("InvitationAcceptedBy")
  apiTokensCreated        ApiToken[]               @relation("ApiTokenCreatedBy")
  auditEvents             AuditEvent[]             @relation("AuditActor")
  notifications           Notification[]
  instanceSettingsUpdated InstanceSetting[]

  projectsOwned         Project[]               @relation("ProjectOwner")
  tasksCreated          Task[]                  @relation("TaskCreator")
  taskAssignments       TaskAssignee[]
  tasksAssignedToOthers TaskAssignee[]          @relation("TaskAssignedBy")
  taskComments          TaskComment[]
  taskActivities        TaskActivity[]
  channelsCreated       Channel[]               @relation("ChannelCreatedBy")
  channelMemberships    ChannelMember[]
  messages              Message[]               @relation("MessageAuthor")
  messagesPinned        Message[]               @relation("MessagePinnedBy")
  messageReactions      MessageReaction[]
  docsCreated           Doc[]                   @relation("DocCreatedBy")
  docsUpdated           Doc[]                   @relation("DocUpdatedBy")
  docRevisions          DocRevision[]
  filesUploaded         FileObject[]
  announcements         Announcement[]
  ledgerEntries         LedgerEntry[]
  invoices              Invoice[]
  assistantChats        AssistantConversation[]
  assistantMemories     AssistantMemory[]
  assistantSkills       AssistantSkill[]
  scheduledJobs         ScheduledJob[]
  integrationsConnected IntegrationConnection[]
  oauthStates           OAuthState[]
  seoAudits             SeoAudit[]
  boardroomSessions     BoardroomSession[]

  // Platform extension: personal rows that cascade with the user.
  teamMemberships         TeamMember[]
  memberProfiles          MemberProfile[]
  availability            Availability[]
  shiftAssignments        ShiftAssignment[]
  certifications          Certification[]
  savedViews              SavedView[]
  bookmarks               Bookmark[]
  meetingAttendance       MeetingAttendee[]
  pollBallots             PollBallotReceipt[]
  ideaVotes               IdeaVote[]
  calendarFeedTokens      CalendarFeedToken[]
  notificationPreferences NotificationPreference[]
  notificationSettings    NotificationUserSettings[]
  notificationMutes       NotificationMute[]
  notificationDigestItems NotificationDigestItem[]
  externalIdentityLinks   ExternalIdentityLink[]
  linkCodes               LinkCode[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Auth.js adapter table. Also stores TOTP replay claims (identifier "mfa-replay").
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One row per recovery code; only an HMAC of the code is stored.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Instance-wide key/value settings managed by the super-admin. Secret values
/// are AES-GCM encrypted (`encrypted = true`) and are write-only in the UI.
model InstanceSetting {
  key         String   @id
  value       String
  encrypted   Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model OutboxMessage {
  id          String       @id @default(cuid())
  kind        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedAt    DateTime?
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
  @@index([createdAt])
}

/// One-row operational state for scheduled work (outbox worker, job runner).
model OperationalHeartbeat {
  key             String    @id
  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastSent        Int       @default(0)
  lastFailed      Int       @default(0)
  lastError       String?
  updatedAt       DateTime  @updatedAt
}

/// Append-only audit trail. Metadata must never carry secrets, tokens or message bodies.
model AuditEvent {
  id              String   @id @default(cuid())
  workspaceId     String?
  actorId         String?
  actorApiTokenId String?
  action          String
  targetType      String?
  targetId        String?
  metadata        Json?
  ip              String?
  createdAt       DateTime @default(now())

  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor         User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorApiToken ApiToken?  @relation(fields: [actorApiTokenId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

/// In-app notification centre item. `kind` is the event type (lib/notify
/// catalogue) when created by `dispatch()`, which also sets `eventId`.
model Notification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String?
  kind        String
  title       String
  body        String?
  url         String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  /// NotificationEventRecord that produced it (null for direct createNotifications calls).
  eventId     String?
  actorId     String?
  archivedAt  DateTime?

  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event     NotificationEventRecord? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([workspaceId, createdAt])
  @@index([eventId])
}

