  children       GovernanceRecord[]     @relation("GovernanceParent")
  organisation   Organisation?          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  meeting        Meeting?               @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  attachments    GovernanceAttachment[]
  bankChanges    GovernanceBankChange[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, kind, key])
  @@unique([workspaceId, kind, number])
  @@unique([workspaceId, organisationId])
  @@index([workspaceId, kind, archivedAt, dueOn])
  @@index([workspaceId, parentId])
  @@index([workspaceId, ownerId])
}

