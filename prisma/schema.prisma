  DELIVERABLE
  DONATION
  CAMPAIGN
  PLEDGE
  DONOR
  PROGRAMME
  KPI
  IMPACT_ENTRY
  RUNWAY
  TOOL_ACCOUNT
  ACCESS_REVIEW
  RECEIPT_SETTINGS
}

model FundingRecord {
  id               String              @id @default(cuid())
  workspaceId      String
