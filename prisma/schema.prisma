model Membership {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole    @default(MEMBER)
  /// Free-text community title, e.g. "Hardware lead".
  title       String?
  status      MembershipStatus @default(ACTIVE)
  joinedAt    DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model Invitation {
  id           String        @id @default(cuid())
  workspaceId  String
  email        String
  role         WorkspaceRole @default(MEMBER)
  /// SHA-256 of the bearer token; the raw token only ever lives in the email.
  tokenHash    String        @unique
  expiresAt    DateTime
  invitedById  String?
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  lastSentAt   DateTime      @default(now())
  createdAt    DateTime      @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User?     @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([email])
}

/// Tenant-bound machine credential for /api/v1 and /api/mcp. Only a hash of
/// the secret is stored; `prefix` identifies the token in lists and lookups.
model ApiToken {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  prefix      String    @unique
  secretHash  String
  scopes      String[]  @default([])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?        @relation("ApiTokenCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  auditEvents AuditEvent[]

  @@index([workspaceId, createdAt])
}

/// Per-workspace monotonic sequences (task numbers, invoice numbers). Use
/// lib/counters.ts `nextWorkspaceSequence` inside the creating transaction.
model WorkspaceCounter {
  workspaceId String
  name        String
  value       Int    @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, name])
}

// ───────────────────────────── Work ─────────────────────────────

model Project {
  id                String        @id @default(cuid())
  workspaceId       String
  /// Short uppercase key shown in task references, e.g. "BOT".
  key               String
  name              String
  description       String?
  status            ProjectStatus @default(ACTIVE)
  ownerId           String?
  startsOn          DateTime?     @db.Date
  dueOn             DateTime?     @db.Date
  /// Owning team (null = workspace-wide). Private teams hide their projects.
  teamId            String?
  /// Per-project toggle for cycles (sprints).
  cyclesEnabled     Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  /// When true only the task creator, assignees, project owner and admins edit a task.
  restrictTaskEdits Boolean       @default(false)

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner         User?                 @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  team          Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  columns       BoardColumn[]
  tasks         Task[]
  githubRepos   GithubRepo[]
  cycles        Cycle[]
  monitors      Monitor[]
  milestones    ProjectMilestone[]
  statusUpdates ProjectStatusUpdate[]
  taskTypes     ProjectTaskType[]

  @@unique([workspaceId, key])
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@index([teamId])
}

model BoardColumn {
  id        String         @id @default(cuid())
  projectId String
  name      String
  position  Int
  category  ColumnCategory @default(TODO)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, position])
}

model Task {
  id              String                   @id @default(cuid())
  workspaceId     String
  projectId       String?
  columnId        String?
  /// Per-workspace sequence (WorkspaceCounter "task").
  number          Int
  title           String
  /// Sanitised HTML.
  description     String?
  priority        TaskPriority             @default(NONE)
  dueAt           DateTime?
  position        Float                    @default(0)
  creatorId       String?
  parentId        String?
  completedAt     DateTime?
  archivedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  /// Generated column (see migration); query with $queryRaw only.
  searchVector    Unsupported("tsvector")? @default(dbgenerated())
  /// Cycle (sprint) the task is planned in.
  cycleId         String?
  /// Recurrence rule that created this instance.
  recurrenceId    String?
  /// Meeting whose notes produced this action item.
  sourceMeetingId String?
  /// Project task type; null shows as the project's default type.
  typeId          String?

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type       ProjectTaskType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  project    Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  column     BoardColumn?     @relation(fields: [columnId], references: [id], onDelete: SetNull)
  creator    User?            @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  parent     Task?            @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks   Task[]           @relation("TaskSubtasks")
  assignees  TaskAssignee[]
  labels     TaskLabel[]
  comments   TaskComment[]
  activities TaskActivity[]
  files      FileObject[]

  cycle              Cycle?                 @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  recurrence         TaskRecurrence?        @relation("TaskRecurrenceInstances", fields: [recurrenceId], references: [id], onDelete: SetNull)
  sourceMeeting      Meeting?               @relation("TaskSourceMeeting", fields: [sourceMeetingId], references: [id], onDelete: SetNull)
  recurrenceRules    TaskRecurrence[]       @relation("TaskRecurrenceTemplate")
  occurrences        TaskOccurrence[]
  blocking           TaskDependency[]       @relation("TaskBlocking")
  blockedBy          TaskDependency[]       @relation("TaskBlocked")
  meetingActionLinks MeetingActionItem[]
  startsOn           DateTime?              @db.Date
  blockerReason      String?
  blockerOwnerId     String?
  milestones         ProjectMilestoneTask[]

  @@unique([workspaceId, number])
  @@unique([workspaceId, projectId, id])
  @@index([projectId, columnId, position])
  @@index([workspaceId, completedAt])
  @@index([workspaceId, dueAt])
  @@index([parentId])
  @@index([searchVector], type: Gin)
  @@index([cycleId])
  @@index([recurrenceId])
  @@index([sourceMeetingId])
  @@index([workspaceId, blockerOwnerId])
  @@index([typeId])
}

model TaskAssignee {
  taskId       String
  userId       String
  assignedAt   DateTime @default(now())
  /// Who made the assignment (the assignee themselves when they claimed it).
  assignedById String?

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([taskId, userId])
  @@index([userId])
  @@index([assignedById])
}

model Label {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  tone        LabelTone @default(NEUTRAL)
  createdAt   DateTime  @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([workspaceId, name])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String?
  body      String
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String?
  kind      String
  data      Json?
  createdAt DateTime @default(now())

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

// ───────────────────────────── Chat ─────────────────────────────

model Channel {
  id            String      @id @default(cuid())
  workspaceId   String
  name          String
  slug          String
  topic         String?
  kind          ChannelKind @default(PUBLIC)
  /// Default channels are joined automatically by new members.
  isDefault     Boolean     @default(false)
  archivedAt    DateTime?
  createdById   String?
  /// For DIRECT channels: "<workspaceId>:<sorted user ids joined by ':'>".
  dmKey         String?     @unique
  lastMessageAt DateTime?
  /// Owning team (null = workspace-wide). Private teams hide their channels.
  teamId        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?            @relation("ChannelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  team      Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  members   ChannelMember[]
  messages  Message[]
  jobs      ScheduledJob[]
  bridges   BridgedChannel[]
  polls     Poll[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, kind])
  @@index([teamId])
}

model ChannelMember {
  channelId  String
  userId     String
  lastReadAt DateTime?
  notify     NotifyLevel @default(ALL)
  joinedAt   DateTime    @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

model Message {
  id           String                   @id @default(cuid())
  workspaceId  String
  channelId    String
  authorId     String?
  authorKind   MessageAuthorKind        @default(USER)
  body         String
  /// Thread root; replies point at it.
  parentId     String?
  replyCount   Int                      @default(0)
  lastReplyAt  DateTime?
  editedAt     DateTime?
  deletedAt    DateTime?
  pinnedAt     DateTime?
  pinnedById   String?
  /// Where the message came from: null (typed here), "notify" (dispatch
  /// WORKSPACE_CHANNEL card) or "bridge:<bridgedChannelId>" (echo prevention).
  origin       String?
  createdAt    DateTime                 @default(now())
  /// Generated column (see migration); query with $queryRaw only.
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel     Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User?               @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  pinnedBy    User?               @relation("MessagePinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)
  parent      Message?            @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Message[]           @relation("MessageThread")
  reactions   MessageReaction[]
  attachments MessageAttachment[]
  bridged     BridgedMessage[]

  @@index([channelId, createdAt])
  @@index([parentId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([searchVector], type: Gin)
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model MessageAttachment {
  messageId String
  fileId    String

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([messageId, fileId])
  @@index([fileId])
}

// ─────────────────────────── Knowledge ───────────────────────────

model Doc {
  id            String                   @id @default(cuid())
  workspaceId   String
  parentId      String?
  title         String
  /// Editor JSON (TipTap). `contentHtml` is the sanitised render, `contentText` the plain text.
  content       Json?
  contentHtml   String                   @default("")
  contentText   String                   @default("")
  position      Float                    @default(0)
  createdById   String?
  updatedById   String?
  archivedAt    DateTime?
  visibility    DocVisibility            @default(WORKSPACE)
  /// Knowledge hygiene: owner confirms the doc is current until this date.
  verifiedUntil DateTime?
  verifiedById  String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  /// Generated column (see migration); query with $queryRaw only.
  searchVector  Unsupported("tsvector")? @default(dbgenerated())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Doc?          @relation("DocTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Doc[]         @relation("DocTree")
  createdBy User?         @relation("DocCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?         @relation("DocUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  revisions DocRevision[]
  files     FileObject[]

  runbookFor        ServiceCatalogItem[]
  meetingNotesFor   Meeting[]
  postmortemFor     Incident[]
  assetManualFor    Asset[]
  signatureRequests SignatureRequest[]

  @@index([workspaceId, parentId, position])
  @@index([searchVector], type: Gin)
}

model DocRevision {
  id          String   @id @default(cuid())
  docId       String
  title       String
  contentHtml String
  authorId    String?
  createdAt   DateTime @default(now())

  doc    Doc   @relation(fields: [docId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([docId, createdAt])
}

/// A private object in S3-compatible storage (lib/storage). Always served
/// through /api/files/[id] after a membership check.
model FileObject {
  documentFiles  DocumentFile[]
  id             String         @id @default(cuid())
  workspaceId    String
  storageKey     String         @unique
  filename       String
  contentType    String
  size           Int
  checksum       String?
  uploadedById   String?
  folder         String         @default("/")
  docId          String?
  taskId         String?
  /// Current version number (FileVersion keeps previous objects).
  currentVersion Int            @default(1)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())

  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy            User?                  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  doc                   Doc?                   @relation(fields: [docId], references: [id], onDelete: SetNull)
  task                  Task?                  @relation(fields: [taskId], references: [id], onDelete: SetNull)
  messageAttachments    MessageAttachment[]
  ledgerReceipts        LedgerEntry[]
  versions              FileVersion[]
  subscriptionContracts Subscription[]
  certificationEvidence Certification[]
  statusPageLogos       StatusPage[]
  signedPdfs            SignatureRequest[]
  opsAttachments        OpsAttachment[]
  governanceAttachments GovernanceAttachment[]
  fundingAttachments    FundingAttachment[]

  financeAttachments      FinanceAttachment[]
  moneyControlAttachments MoneyControlAttachment[]
  safeguardingAttachments SafeguardingAttachment[]
  orgPeopleAttachments    OrgPeopleAttachment[]
  marketingItAttachments  MarketingItAttachment[]
  productAttachments      ProductAttachment[]

  @@unique([workspaceId, id])
  @@index([workspaceId, folder])
  @@index([docId])
  @@index([taskId])
}

// ─────────────────────────── Community ───────────────────────────

model Announcement {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  body        String
  authorId    String?
  pinned      Boolean   @default(false)
  /// Null while a draft.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, publishedAt])
}

// ────────────────────────── Operations ──────────────────────────

model FinanceCategory {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  kind        LedgerKind
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   LedgerEntry[]

  @@unique([workspaceId, kind, name])
}

/// Money is stored in minor units (paise for INR) as integers.
model LedgerEntry {
  id            String     @id @default(cuid())
  workspaceId   String
  kind          LedgerKind
  amountMinor   Int
  currency      String
  categoryId    String?
  description   String
  counterparty  String?
  occurredOn    DateTime   @db.Date
  receiptFileId String?
  createdById   String?
  /// Budget this entry counts against.
  budgetId      String?
  /// Idempotent posting from another record, e.g. ("reimbursement", id).
  sourceType    String?
  sourceId      String?
  voidedAt      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  receiptFile FileObject?      @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  budget      Budget?          @relation(fields: [budgetId], references: [id], onDelete: SetNull)

  // Manual finance tools. Salary postings remain private to payroll grantees.
  fundId         String?
  costCentreId   String?
  accountId      String?
  incomeSource   String             @default("OTHER")
  purpose        String?
  invoiceNumber  String?
  gstin          String?
  taxableMinor   Int                @default(0)
  cgstMinor      Int                @default(0)
  sgstMinor      Int                @default(0)
  igstMinor      Int                @default(0)
  tdsMinor       Int                @default(0)
  extractionUsed Boolean            @default(false)
  privatePayroll Boolean            @default(false)
  reconciledAt   DateTime?
  fund           FinanceFund?       @relation(fields: [workspaceId, fundId], references: [workspaceId, id], onDelete: NoAction)
  costCentre     FinanceCostCentre? @relation(fields: [workspaceId, costCentreId], references: [workspaceId, id], onDelete: NoAction)
  account        FinanceAccount?    @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: NoAction)

  @@unique([workspaceId, id])
  @@unique([sourceType, sourceId])
  @@index([workspaceId, fundId, occurredOn])
  @@index([workspaceId, costCentreId, occurredOn])
  @@index([workspaceId, accountId, occurredOn])
  @@index([workspaceId, occurredOn])
  @@index([categoryId])
  @@index([budgetId])
}

model Invoice {
  id          String        @id @default(cuid())
  workspaceId String
  /// Display number, unique per workspace (WorkspaceCounter "invoice").
  number      String
  clientName  String
  clientEmail String?
  status      InvoiceStatus @default(DRAFT)
  issuedOn    DateTime      @db.Date
  dueOn       DateTime?     @db.Date
  currency    String
  /// [{ description, quantity, unitMinor }]
  items       Json
  totalMinor  Int
  notes       String?
  paidAt      DateTime?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
}

// ─────────────────────────── Assistant ───────────────────────────

model AssistantConversation {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  title       String   @default("New conversation")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         AssistantMessage[]
  messagingThreads MessagingConversation[]

  @@index([workspaceId, userId, updatedAt])
}

model AssistantMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AssistantRole
  /// Anthropic content blocks (text, tool_use, tool_result).
  content        Json
  tokensIn       Int?
  tokensOut      Int?
  createdAt      DateTime      @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AssistantMemory {
  id          String   @id @default(cuid())
  workspaceId String
  content     String
  tags        String[] @default([])
  createdById String?
  /// "manual", "assistant" or "job".
  source      String   @default("manual")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model AssistantSkill {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String
  body        String
  enabled     Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
}

model ScheduledJob {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  /// Five-field cron expression evaluated in `timezone`.
  cron        String
  timezone    String    @default("Asia/Kolkata")
  prompt      String
  /// Channel to post the result into; null keeps it in the assistant log.
  channelId   String?
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  lastStatus  String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel   Channel?  @relation(fields: [channelId], references: [id], onDelete: SetNull)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([enabled, nextRunAt])
  @@index([workspaceId])
}

// ────────────────────────── Integrations ──────────────────────────

/// A workspace-level connection to Google, a GitHub App installation or the
/// Telegram bot. OAuth tokens are AES-GCM encrypted with
/// INTEGRATION_ENCRYPTION_KEY (lib/integrationSecrets.ts) and never leave the server.
model IntegrationConnection {
  id              String              @id @default(cuid())
  workspaceId     String
  provider        IntegrationProvider
  accountLabel    String
  /// Provider-side id: Google account sub, GitHub installation id, Telegram bot id.
  externalId      String
  scopes          String[]            @default([])
  accessTokenEnc  String?
  refreshTokenEnc String?
  expiresAt       DateTime?
  metadata        Json?
  connectedById   String?
  status          IntegrationStatus   @default(ACTIVE)
  lastSyncedAt    DateTime?
  lastError       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy User?        @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  githubRepos GithubRepo[]
  seoSites    SeoSite[]

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, provider])
}

/// Single-use OAuth CSRF state. Only a SHA-256 of the state value is stored.
model OAuthState {
  id           String              @id @default(cuid())
  stateHash    String              @unique
  workspaceId  String
  userId       String
  provider     IntegrationProvider
  redirectPath String              @default("/")
  expiresAt    DateTime
  createdAt    DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model GithubRepo {
  id              String   @id @default(cuid())
  workspaceId     String
  connectionId    String
  /// "owner/name".
  fullName        String
  installationId  String
  defaultBranch   String   @default("main")
  private         Boolean  @default(false)
  linkedProjectId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection    IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  linkedProject Project?              @relation(fields: [linkedProjectId], references: [id], onDelete: SetNull)
  events        GithubEvent[]

  @@unique([workspaceId, fullName])
  @@index([connectionId])
  @@index([linkedProjectId])
}

/// Webhook activity feed. `deliveryId` (X-GitHub-Delivery) makes redelivery idempotent.
model GithubEvent {
  id          String   @id @default(cuid())
  workspaceId String
  repoId      String?
  deliveryId  String   @unique
  kind        String
  action      String?
  title       String
  url         String?
  actorLogin  String?
  payload     Json?
  receivedAt  DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repo      GithubRepo? @relation(fields: [repoId], references: [id], onDelete: SetNull)

  @@index([workspaceId, receivedAt])
  @@index([repoId, receivedAt])
}

// ───────────────────────────── SEO ─────────────────────────────

model SeoSite {
  id           String    @id @default(cuid())
  workspaceId  String
  /// Search Console property, e.g. "sc-domain:example.org" or "https://example.org/".
  siteUrl      String
  connectionId String?
  verified     Boolean   @default(false)
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace  Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  metrics    SeoMetricDaily[]
  audits     SeoAudit[]

  @@unique([workspaceId, siteUrl])
}

/// Daily Search Console rows. `query`/`page` are empty strings for site totals.
model SeoMetricDaily {
  id          String   @id @default(cuid())
  siteId      String
  date        DateTime @db.Date
  query       String   @default("")
  page        String   @default("")
  clicks      Int      @default(0)
  impressions Int      @default(0)
  ctr         Float    @default(0)
  position    Float    @default(0)

  site SeoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date, query, page])
  @@index([siteId, date])
}

model SeoAudit {
  id          String   @id @default(cuid())
  siteId      String
  url         String
  /// "queued", "running", "done" or "failed".
  status      String   @default("queued")
  findings    Json?
  score       Int?
  createdById String?
  createdAt   DateTime @default(now())

  site      SeoSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
}

// ─────────────────────────── Boardroom ───────────────────────────

model BoardroomSession {
  id          String          @id @default(cuid())
  workspaceId String
  title       String
  question    String
  status      BoardroomStatus @default(DRAFT)
  rounds      Int             @default(2)
  createdById String?
  summary     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  seats     BoardroomSeat[]
  turns     BoardroomTurn[]

  @@index([workspaceId, createdAt])
}

model BoardroomSeat {
  id        String   @id @default(cuid())
  sessionId String
  name      String
  persona   String
  model     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  session BoardroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turns   BoardroomTurn[]

  @@index([sessionId, position])
}

model BoardroomTurn {
  id        String            @id @default(cuid())
  sessionId String
  seatId    String?
  round     Int
  role      BoardroomTurnRole @default(SEAT)
  content   String
  createdAt DateTime          @default(now())

  session BoardroomSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  seat    BoardroomSeat?   @relation(fields: [seatId], references: [id], onDelete: SetNull)

  @@index([sessionId, round, createdAt])
}

// ═══════════════════════ Platform extension ═══════════════════════
//
// Internal-team features, the Services monitor and messaging + notification
// routing. Ownership per area is in docs/ROADMAP-BUILD.md. Encrypted columns
// (`*Enc`) hold "v1.<iv>.<tag>.<ciphertext>" strings from lib/crypto.ts
// (`encryptSecret` with a dedicated purpose), except the vault, which uses
// envelope encryption under VAULT_MASTER_KEY. Money follows the app rule:
// integer minor units plus an ISO currency (cloud cost snapshots keep the
// provider's fractional amounts as Decimal).

// ─────────────────────── Extension enums ───────────────────────

enum TeamRole {
  LEAD
  MEMBER
}

enum TeamVisibility {
  PUBLIC
  PRIVATE
}

/// Who can see a record: only its owner (and admins), its team, or everyone in the workspace.
enum Visibility {
  PRIVATE
  TEAM
  WORKSPACE
}

enum ApprovalSubjectType {
  PURCHASE_REQUEST
  REIMBURSEMENT
  FORM_SUBMISSION
