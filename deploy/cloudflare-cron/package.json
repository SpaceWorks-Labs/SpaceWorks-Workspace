{
  "name": "spaceworks-workspace-cron",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Cloudflare Worker cron that wakes Space Works Workspace and runs its outbox and periodic jobs every minute.",
  "scripts": {
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "wrangler dev --test-scheduled",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
