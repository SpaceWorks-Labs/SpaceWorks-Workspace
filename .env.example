# Space Works Workspace configuration. Copy to `.env` for local development.
# Names only with safe placeholders: never commit real values.
# Production preflight: `npm run production:check` (see AGENTS.md).

# ── Database (PostgreSQL 16) ─────────────────────────────────────────────
# Runtime connection (may be a transaction pooler with ?pgbouncer=true).
DATABASE_URL="postgresql://sww:sww_dev_password@127.0.0.1:5440/sww_dev"
# Direct/session connection for `prisma migrate`; defaults to DATABASE_URL.
DIRECT_URL=""
# Disposable database for `npm run test:integration` (it gets wiped).
TEST_DATABASE_URL="postgresql://sww:sww_dev_password@127.0.0.1:5440/sww_dev_test"

# ── Auth ────────────────────────────────────────────────────────────────
# `openssl rand -base64 33`
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Optional Google sign-in for invited members (instance settings override these).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# The instance operator. Signs in normally, then passes a fresh TOTP step-up for /admin.
SUPER_ADMIN_EMAIL="owner@example.org"

# ── Encryption keys (`openssl rand -base64 32`) ───────────────────────────
# MFA seeds; instance-setting secrets use a domain-separated subkey of it.
MFA_ENCRYPTION_KEY=""
# OAuth tokens for Google/GitHub integrations (falls back to a subkey of MFA_ENCRYPTION_KEY).
INTEGRATION_ENCRYPTION_KEY=""
# Credentials vault master key (envelope encryption; the VPS installer generates it).
# Keep it separate from every other key and back it up: without it vault secrets
# cannot be revealed.
VAULT_MASTER_KEY=""
# Stable Server Action encryption across builds and replicas (16/24/32-byte base64).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# ── Operational bearer secrets (32+ characters) ──────────────────────────
CRON_SECRET=""
HEALTHCHECK_SECRET=""

# ── Redis (rate limits + realtime fan-out; rediss:// in production) ─────────
REDIS_URL="redis://127.0.0.1:6395/0"

# ── Object storage: Silo locally / on a VPS, Cloudflare R2 in the cloud ─────
S3_BUCKET="sww-dev"
S3_REGION="us-east-1"
S3_ENDPOINT="http://127.0.0.1:9010"
S3_ACCESS_KEY_ID="swwdev"
S3_SECRET_ACCESS_KEY="sww_dev_storage_pw"
S3_FORCE_PATH_STYLE="1"
# Largest single upload in bytes (default 25 MB).
UPLOAD_MAX_BYTES=""

# ── Email (instance settings in /admin override these) ────────────────────
EMAIL_FROM="Space Works <workspace@localhost>"
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_SERVICE=""
SMTP_USER=""
SMTP_PASSWORD=""
# Local Mailpit only. Production SMTP must authenticate.
SMTP_ALLOW_UNAUTHENTICATED="1"
OUTBOX_RETENTION_DAYS=""

# ── Assistant (instance settings in /admin override these) ─────────────────
ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-opus-5-5"
# Optional self-hosted web search for the assistant.
SEARXNG_URL=""

# ── Integrations ────────────────────────────────────────────────────────
# Google Calendar / Gmail / Drive / Search Console (may reuse AUTH_GOOGLE_*).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_APP_ID=""
GITHUB_APP_NAME=""
# PEM contents, or a path in GITHUB_APP_PRIVATE_KEY_FILE.
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_PRIVATE_KEY_FILE=""
GITHUB_WEBHOOK_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# ── Messaging and notification routing ─────────────────────────────────
# Slack, Discord, Mattermost, Telegram and WhatsApp credentials are stored per
# workspace (encrypted, write-only) under Settings › Messaging, not here.
# Allow webhook destinations on private network addresses (default false).
ALLOW_PRIVATE_WEBHOOK_TARGETS=""
# Parallel notification deliveries per worker pass (default 10).
NOTIFY_WORKER_CONCURRENCY=""

# ── Services monitor ──────────────────────────────────────────────────────
# Cloud account tokens are stored per workspace (encrypted, write-only) under
# Settings › Cloud accounts, not here.
# Let admins allow-list private targets (10.x, 192.168.x…) for monitors (default false).
MONITOR_ALLOW_PRIVATE_TARGETS=""
# Monitors per workspace (default 100).
MONITOR_MAX_PER_WORKSPACE=""

# ── Deployment ──────────────────────────────────────────────────────────
# Which header carries the client IP behind your proxy: cf-connecting-ip | x-forwarded-for | x-real-ip
TRUSTED_PROXY_IP_HEADER=""
# With x-forwarded-for behind an appending proxy: number of trusted hops.
TRUSTED_PROXY_HOPS=""
# Extra origins allowed to post Server Actions (comma-separated), e.g. behind a CDN.
ALLOWED_ACTION_ORIGINS=""
# Opt in to local development delivery without Redis. Never enabled in production.
JOBS_INPROCESS=""

# ── Local demo data (`npm run db:seed:demo`) ──────────────────────────────
DEMO_PASSWORD=""

# Separate frontend/backend hosting (leave unset for one runtime).
DEPLOYMENT_MODE=""
BACKEND_ORIGIN=""
NEXT_PUBLIC_BACKEND_ORIGIN=""
FRONTEND_GATEWAY_SECRET=""
FRONTEND_TRUSTED_IP_HEADER=""

# Background worker + beat (requires persistent Redis with noeviction).
# Per-queue concurrency: integer 1..64. Defaults: 5, 2, 2, 1, 1.
QUEUE_OUTBOX_CONCURRENCY=5
QUEUE_SCHEDULED_CONCURRENCY=2
QUEUE_SYNC_CONCURRENCY=2
QUEUE_MONITOR_CONCURRENCY=1
QUEUE_DOCUMENTS_CONCURRENCY=1
# Private health server in each worker/beat process; never expose publicly.
JOBS_HEALTH_PORT=3460
# Local supervisor only: different host health ports for worker and beat.
SWW_DEV_WORKER_PORT=3460
SWW_DEV_BEAT_PORT=3461
