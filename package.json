{
  "name": "spaceworks-workspace",
  "version": "0.6.6",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/prisma.mjs migrate dev",
    "db:deploy": "node --env-file-if-exists=.env scripts/prisma.mjs migrate deploy",
    "db:status": "node --env-file-if-exists=.env scripts/prisma.mjs migrate status",
    "db:test:prepare": "node --env-file-if-exists=.env scripts/prepare-test-db.mjs",
    "db:studio": "node --env-file-if-exists=.env scripts/prisma.mjs studio",
    "db:seed:demo": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/db-backup.mjs",
    "db:restore": "node --env-file-if-exists=.env scripts/db-restore.mjs",
    "storage:init": "node --env-file-if-exists=.env scripts/storage-init.mjs",
    "production:check": "node scripts/check-production-env.mjs",
    "docker:dev": "docker compose up -d --wait",
    "docker:down": "docker compose stop",
    "docker:build": "docker build --tag spaceworks-workspace:local .",
    "readme:art": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-readme-art.ts",
    "frontend:catalog": "next typegen && node scripts/generate-frontend-catalog.mjs && node scripts/generate-frontend-types.mjs",
    "frontend:prepare": "node scripts/prepare-frontend.mjs",
    "build:frontend": "npm run build --workspace=frontend",
    "typecheck:frontend": "node scripts/check-frontend-boundary.mjs && npm run frontend:prepare && npm run typecheck --workspace=frontend",
    "test:e2e:split": "node scripts/test-split-hosting.mjs",
    "test:e2e:vps": "node scripts/test-split-hosting.mjs --monolith",
    "db:verify": "node scripts/verify-production-schema.mjs",
    "deployment:check": "node scripts/check-deployment.mjs",
    "build:jobs": "node scripts/build-jobs.mjs",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "beat": "node --env-file-if-exists=.env dist/beat.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-cloudwatch": "3.1116.0",
    "@aws-sdk/client-cost-explorer": "3.1116.0",
    "@aws-sdk/client-ec2": "3.1116.0",
    "@aws-sdk/client-ecs": "3.1116.0",
    "@aws-sdk/client-lightsail": "3.1116.0",
    "@aws-sdk/client-rds": "3.1116.0",
    "@aws-sdk/client-route-53": "3.1116.0",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/client-sts": "3.1116.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extension-mention": "3.30.5",
    "@tiptap/extension-table": "3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/suggestion": "3.30.5",
    "@types/sanitize-html": "^2.16.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "5.81.5",
    "clsx": "2.1.1",
    "cron-parser": "^5.10.2",
    "htmlparser2": "10.1.0",
    "ioredis": "^6.0.0",
    "lucide-react": "1.49.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "10.2.1",
    "otpauth": "^9.5.1",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "3.7.0",
    "tldts": "7.4.18",
    "undici": "7.30.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "fontkit": "^2.0.4",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "yaml": "^2.8.1"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.11.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "workspaces": [
    "frontend",
    "packages/cli"
  ]
}
