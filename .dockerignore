# Keep secrets, generated output and developer-only files out of the Docker
# build context. Runtime secrets come from the deployment platform.
.env
.env.*
!.env.example
.git
.github
.next
node_modules
backups/
tls/
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
coverage
playwright-report
test-results
screenshots
tests
playwright.config.ts
*.log
*.tsbuildinfo
.DS_Store
.data
# Local agent and editor state (agent worktrees are full repository copies).
.claude
.cursor
.impeccable
.idea
.vscode
# Deployment tooling that is never part of the application image.
deploy/
charts/
.do/
render.yaml
compose.*.yml
docker-compose*.yml
docker-compose.yml
install.sh
local.sh
.wrangler

config/
.sww-*
.spaceworks-workspace-*

frontend-public/

frontend/app
frontend/components
frontend/lib
frontend/public
frontend/.next
frontend/node_modules

# Rebuilt from source in the builder stage
dist/
